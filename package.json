{
  "name": "mytrade",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run && python -m pytest -q",
    "preview": "vite preview",
    "gateway": "python gateway/app.py",
    "gateway:setup": "python -m venv build/gateway-venv && build/gateway-venv/Scripts/python -m pip install -r gateway/requirements-build.txt",
    "gateway:build": "node scripts/build-gateway.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@heyphat/piner": "0.13.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
