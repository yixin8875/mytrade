{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyTrade",
  "version": "0.5.1",
  "identifier": "com.mytrade.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run gateway:build && npm run dev",
    "beforeBuildCommand": "npm run gateway:build && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MyTrade · MT5",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#131722",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0OERGMjY4QkM5RTFFOTYKUldTV0hwNjhhUEtOcElWZUNLOGZoT1g4WVV6OFJpUmZlM1hCOU4rdkk0UkJ0dE1rZGZnYSs4Y0kK",
      "endpoints": [
        "https://github.com/yixin8875/mytrade/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/mytrade-gateway"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
